{
  "name": "@reliverse/rempts-plugin-completions",
  "version": "0.1.0",
  "description": "Shell completions plugin for Rempts CLI framework",
  "keywords": [
    "bash",
    "cli",
    "completions",
    "fish",
    "rempts",
    "shell",
    "zsh"
  ],
  "license": "MIT",
  "author": "bun dler Team",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/mod.ts",
      "default": "./src/mod.ts"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts && bun run tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reliverse/rempts-core": "workspace:*",
    "@reliverse/rempts-generator": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@reliverse/tsconfig": "workspace:*",
    "typescript": "^5.8.3"
  }
}
