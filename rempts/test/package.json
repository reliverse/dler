{
  "name": "@reliverse/rempts-test",
  "version": "0.2.0",
  "type": "module",
  "description": "Testing utilities for Rempts CLI applications",
  "module": "./src/mod.ts",
  "types": "./src/mod.ts",
  "exports": {
    ".": {
      "import": "./src/mod.ts",
      "types": "./src/mod.ts"
    }
  },
  "files": [
    "dist"
  ],
  "author": "blefnk",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reliverse/rempts.git",
    "directory": "packages/test"
  },
  "bugs": {
    "url": "https://github.com/reliverse/rempts/issues"
  },
  "homepage": "https://github.com/reliverse/rempts#readme",
  "keywords": [
    "rempts",
    "test",
    "testing",
    "cli",
    "bun",
    "typescript",
    "matchers",
    "assertions"
  ],
  "scripts": {
    "build": "bun scripts/build.ts && bun run tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "bun": ">=1.3.5"
  },
  "dependencies": {
    "@reliverse/rempts-core": "workspace:*"
  },
  "devDependencies": {
    "@reliverse/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}