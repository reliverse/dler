{
  "name": "@reliverse/dler",
  "version": "2.3.0",
  "description": "@reliverse/dler is a framework which helps TypeScript and JavaScript developers create their libraries and CLI tools. It provides ready-to-use primitives, so you don't have to write them from scratch.",
  "keywords": [
    "build-tool",
    "bun",
    "cli",
    "development",
    "rempts",
    "toolchain",
    "typescript"
  ],
  "homepage": "https://github.com/reliverse/dler#readme",
  "bugs": {
    "url": "https://github.com/reliverse/dler/issues"
  },
  "license": "MIT",
  "author": "blefnk",
  "repository": {
    "type": "git",
    "url": "https://github.com/reliverse/dler.git",
    "directory": "packages/cli"
  },
  "bin": {
    "dler": "./src/cli.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./src/mod.ts",
  "types": "./src/mod.ts",
  "exports": {
    ".": {
      "types": "./src/mod.ts",
      "import": "./src/mod.ts"
    }
  },
  "scripts": {
    "dler": "bun src/cli.ts",
    "generate": "bun dler generate",
    "dev": "bun dler dev",
    "typecheck": "tsc --noEmit",
    "cli": "bun cli.ts",
    "build": "bun scripts/build.ts && bun run tsc",
    "build:standalone": "bun run scripts/build.ts --compile",
    "build:binaries": "bun run scripts/release-binaries.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@reliverse/build": "workspace:*",
    "@reliverse/bump": "workspace:*",
    "@reliverse/config": "workspace:*",
    "@reliverse/datetime": "workspace:*",
    "@reliverse/helpers": "workspace:*",
    "@reliverse/mapkit": "workspace:*",
    "@reliverse/matcha": "workspace:*",
    "@reliverse/pathkit": "workspace:*",
    "@reliverse/publish": "workspace:*",
    "@reliverse/relico": "workspace:*",
    "@reliverse/relifso": "workspace:*",
    "@reliverse/relinka": "workspace:*",
    "@reliverse/rempts": "workspace:*",
    "@reliverse/rempts-generator": "workspace:*",
    "@reliverse/rempts-utils": "workspace:*",
    "@reliverse/typerso": "workspace:*",
    "c12": "catalog:",
    "clipboardy": "catalog:",
    "lookpath": "catalog:",
    "semver": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@reliverse/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/semver": "catalog:",
    "typescript": "catalog:"
  }
}
