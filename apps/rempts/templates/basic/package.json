{
  "name": "{{name}}",
  "version": "0.1.0",
  "type": "module",
  "description": "{{description}}",
  "author": "{{author}}",
  "bin": {
    "{{name}}": "./dist/mod.js"
  },
  "scripts": {
    "postinstall": "bun dler generate",
    "dev": "bun run src/mod.ts",
    "build": "bun dler build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reliverse/rempts-core": "latest"
  },
  "devDependencies": {
    "@reliverse/tsconfig": "workspace:*",
    "@reliverse/rempts-test": "latest",
    "@types/bun": "latest",
    "rempts": "latest",
    "typescript": "^5.0.0"
  },
  "rempts": {
    "entry": "./src/mod.ts",
    "outDir": "./dist"
  }
}