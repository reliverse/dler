{
  "name": "@{{name}}/core",
  "version": "2.3.0",
  "description": "Core functionality for {{name}}",
  "license": "MIT",
  "author": "{{author}}",
  "type": "module",
  "main": "./dist/mod.js",
  "types": "./src/mod.ts",
  "exports": {
    ".": {
      "types": "./src/mod.ts",
      "import": "./src/mod.ts"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts && bun run tsc",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reliverse/rempts-core": "workspace:*",
    "@{{name}}/utils": "workspace:*",
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@reliverse/rempts-test": "workspace:*",
    "@reliverse/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
