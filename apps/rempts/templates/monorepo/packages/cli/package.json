{
  "name": "@{{name}}/cli",
  "version": "0.1.0",
  "description": "CLI for {{name}}",
  "license": "MIT",
  "author": "{{author}}",
  "bin": {
    "{{name}}": "./src/mod.ts"
  },
  "type": "module",
  "scripts": {
    "postinstall": "bun dler generate",
    "dev": "bun run src/mod.ts",
    "build": "bun dler build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reliverse/rempts-core": "workspace:*",
    "@{{name}}/core": "workspace:*",
    "@{{name}}/utils": "workspace:*"
  },
  "devDependencies": {
    "@reliverse/rempts-test": "workspace:*",
    "@reliverse/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "rempts": "workspace:*",
    "typescript": "catalog:"
  },
  "rempts": {
    "entry": "./src/mod.ts",
    "outDir": "./dist",
    "external": [
      "@reliverse/rempts-core",
      "@{{name}}/core",
      "@{{name}}/utils"
    ]
  }
}
