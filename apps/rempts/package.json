{
  "name": "@reliverse/rempts",
  "version": "0.4.0",
  "description": "Scaffold new Rempts CLI projects with ease",
  "keywords": [
    "bun",
    "cli",
    "create",
    "rempts",
    "scaffold",
    "starter",
    "template",
    "typescript"
  ],
  "homepage": "https://github.com/reliverse/rempts#readme",
  "bugs": {
    "url": "https://github.com/reliverse/rempts/issues"
  },
  "license": "MIT",
  "author": "blefnk",
  "repository": {
    "type": "git",
    "url": "https://github.com/reliverse/rempts.git",
    "directory": "packages/rempts"
  },
  "bin": {
    "rempts": "./src/cli.ts"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "module": "./src/mod.ts",
  "types": "./src/mod.ts",
  "exports": {
    ".": {
      "types": "./src/mod.ts",
      "import": "./src/mod.ts"
    }
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun scripts/build.ts && bun run tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@reliverse/relico": "workspace:*",
    "@reliverse/rempts-core": "workspace:*",
    "@reliverse/rempts-test": "workspace:*",
    "@reliverse/rempts-utils": "workspace:*",
    "giget": "^2.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@reliverse/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}
