{
  "name": "@reliverse/rempts",
  "version": "2.3.2",
  "description": "Scaffold new Rempts CLI projects with ease",
  "keywords": [
    "bun",
    "cli",
    "create",
    "rempts",
    "scaffold",
    "starter",
    "template",
    "typescript"
  ],
  "homepage": "https://github.com/reliverse/dler#readme",
  "bugs": {
    "url": "https://github.com/reliverse/dler/issues"
  },
  "license": "MIT",
  "author": "blefnk",
  "repository": {
    "type": "git",
    "url": "https://github.com/reliverse/dler.git",
    "directory": "packages/rempts"
  },
  "bin": {
    "rempts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "type": "module",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./src/mod.ts",
      "import": "./src/mod.ts"
    }
  },
  "dependencies": {
    "@reliverse/relico": "workspace:*",
    "@reliverse/rempts-core": "workspace:*",
    "@reliverse/rempts-test": "workspace:*",
    "@reliverse/rempts-utils": "workspace:*",
    "arktype": "catalog:",
    "giget": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@reliverse/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun scripts/build.ts && bun run tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  }
}
