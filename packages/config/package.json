{
  "name": "@reliverse/config",
  "version": "2.3.4",
  "private": false,
  "description": "Configuration management for Reliverse ecosystem",
  "keywords": [
    "build",
    "config",
    "dler",
    "publish"
  ],
  "license": "MIT",
  "author": "reliverse",
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/mod.ts",
      "default": "./src/mod.ts"
    },
    "./config-loader": {
      "types": "./src/impl/config-loader.ts",
      "default": "./src/impl/config-loader.ts"
    },
    "./impl/*": {
      "types": "./src/impl/*.ts",
      "default": "./src/impl/*.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@reliverse/matcha": "workspace:*",
    "@reliverse/rempts": "workspace:*",
    "@reliverse/typerso": "workspace:*",
    "c12": "catalog:",
    "semver": "catalog:",
    "left-pad": "^1.3.0"
  },
  "devDependencies": {
    "@reliverse/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/semver": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "scripts": {
    "perf": "bun bench/perf.ts"
  }
}
