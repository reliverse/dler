{
  "name": "@reliverse/utils",
  "version": "0.1.0",
  "description": "Shared utilities for Reliverse packages",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/mod.ts"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./src/validation.ts"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": ">=5.9.3"
  },
  "peerDependencies": {
    "typescript": ">=5.9.3"
  }
}
