{
  "name": "@reliverse/utils",
  "version": "2.3.4",
  "description": "Shared utilities for Reliverse packages",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/mod.ts"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./src/validation.ts"
    }
  },
  "dependencies": {
    "arktype": "catalog:",
    "lodash": "^4.17.21",
    "immutable": "^5.1.4"
  },
  "peerDependencies": {
    "typescript": ">=5.9.3"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": ">=5.9.3"
  },
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsgo --noEmit",
    "clean": "rm -rf dist"
  }
}
