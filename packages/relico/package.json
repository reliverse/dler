{
  "name": "@reliverse/relico",
  "version": "2.3.0",
  "description": "@reliverse/relico is a themeable, chainable, typed, truecolor-powered, modern terminal styling toolkit. Designed to make your CLI output colorful, accessible, and human-friendly. It gives you a flexible way to apply colors and styles, with reliability and a smart developer experience baked in. Built for humans, not just terminals.",
  "keywords": [
    "cli",
    "prompts",
    "rempts",
    "spinner",
    "terminal",
    "utilities"
  ],
  "homepage": "https://github.com/reliverse/rempts#readme",
  "bugs": {
    "url": "https://github.com/reliverse/rempts/issues"
  },
  "license": "MIT",
  "author": "blefnk",
  "repository": {
    "type": "git",
    "url": "https://github.com/reliverse/rempts.git",
    "directory": "packages/utils"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "module": "./src/mod.ts",
  "types": "./src/mod.ts",
  "exports": {
    ".": {
      "types": "./src/mod.ts",
      "import": "./src/mod.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts && bun run tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@standard-schema/utils": "^0.3.0"
  },
  "devDependencies": {
    "@reliverse/tsconfig": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "bun": ">=1.3.5"
  },
  "engines": {
    "bun": ">=1.3.5"
  }
}
